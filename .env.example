# ─────────────────────────────────────────────────────────────────────────────
# FlyttGo USA — Environment Variables Template
#
# LOCAL:  copy this file to .env.local and fill in real values.
# VERCEL: add the same variables under Project → Settings → Environment
#         Variables. Because the Vercel–Supabase integration is enabled,
#         these should be sourced from the linked Supabase project so the
#         deployed site always talks to the same database as GitHub CI.
#
# NEVER commit .env.local to Git.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (required)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Maps (required for address autocomplete in HomePage)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Stripe (optional — only needed if Stripe checkout is live)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Edge function secrets — set via `supabase secrets set <name>=<value>`,
# NOT in .env.local. Listed here so contributors know what each function
# expects to find in its Deno.env at runtime. See docs/DEPLOYMENT.md for the
# canonical list and rotation cadence.
# ─────────────────────────────────────────────────────────────────────────────

# Stripe — create-checkout-session, process-payment, stripe-webhook
# STRIPE_SECRET_KEY=sk_live_or_sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Resend / email provider — send-booking-email, send-contact-message
# RESEND_API_KEY=re_...
# FRONTEND_URL=https://flyttgo.com

# route-distance (default OSRM, no key). For OpenRouteService:
# ROUTE_PROVIDER_KIND=ors
# ROUTE_PROVIDER_URL=https://api.openrouteservice.org
# ROUTE_PROVIDER_KEY=...

# geocode-address (default Nominatim, no key). For Google or Mapbox:
# GEOCODE_PROVIDER_KIND=google     # or: mapbox
# GEOCODE_PROVIDER_KEY=...
# GEOCODE_PROVIDER_URL=             # optional — self-hosted Nominatim base
# GEOCODE_USER_AGENT=FlyttGo/1.0 (https://flyttgo.com)
