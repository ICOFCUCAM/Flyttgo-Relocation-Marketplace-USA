{
  "name": "FlyttGo Global Logistics & Relocation Marketplace",
  "short_name": "FlyttGo",
  "description": "Worldwide marketplace connecting customers with licensed movers, packers, storage and relocation providers across 16 countries — USA · Canada · UK · France · Germany · Norway plus expansion markets in the Netherlands, Sweden, Spain, Italy, Poland, Denmark, Belgium, Austria, Switzerland, and the Czech Republic.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "background_color": "#0b1f3a",
  "theme_color": "#0b1f3a",
  "orientation": "portrait-primary",
  "lang": "en",
  "dir": "ltr",
  "id": "/?source=pwa",
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    {
      "src": "/favicon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.svg",
      "type": "image/svg+xml",
      "sizes": "180x180",
      "purpose": "any maskable"
    }
  ],
  "categories": ["business", "lifestyle", "productivity", "travel"],
  "share_target": {
    "action": "/?source=pwa-share",
    "method": "GET",
    "params": {
      "title": "title",
      "text":  "text",
      "url":   "url"
    }
  },
  "shortcuts": [
    {
      "name": "Get a quote",
      "short_name": "Quote",
      "description": "Compare licensed movers in 60 seconds",
      "url": "/book?source=pwa-shortcut",
      "icons": [{ "src": "/favicon.svg", "sizes": "any" }]
    },
    {
      "name": "Track a move",
      "short_name": "Track",
      "description": "Live driver tracking + ETA",
      "url": "/track?source=pwa-shortcut",
      "icons": [{ "src": "/favicon.svg", "sizes": "any" }]
    },
    {
      "name": "My bookings",
      "short_name": "My moves",
      "url": "/my-bookings?source=pwa-shortcut",
      "icons": [{ "src": "/favicon.svg", "sizes": "any" }]
    },
    {
      "name": "Browse marketplace",
      "short_name": "Browse",
      "description": "16 country marketplaces in one app",
      "url": "/marketplace?source=pwa-shortcut",
      "icons": [{ "src": "/favicon.svg", "sizes": "any" }]
    }
  ],
  "screenshots": [
    {
      "src": "/og/market-us.svg",
      "sizes": "1200x630",
      "type": "image/svg+xml",
      "form_factor": "wide",
      "label": "FlyttGo United States marketplace"
    },
    {
      "src": "/og/market-uk.svg",
      "sizes": "1200x630",
      "type": "image/svg+xml",
      "form_factor": "wide",
      "label": "FlyttGo United Kingdom marketplace"
    },
    {
      "src": "/og/market-nl.svg",
      "sizes": "1200x630",
      "type": "image/svg+xml",
      "form_factor": "wide",
      "label": "FlyttGo Netherlands — activating"
    },
    {
      "src": "/og.svg",
      "sizes": "1200x630",
      "type": "image/svg+xml",
      "form_factor": "narrow",
      "label": "FlyttGo Global Marketplace"
    }
  ]
}
